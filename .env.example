# Wallets: paste one private key per line at the top of this file.
# Do not add PRIVATE_KEY_1= and do not add the 0x prefix.
# Replace the placeholders below with real 64-character hexadecimal keys.
# <WALLET_PRIVATE_KEY_1_WITHOUT_0x>
# <WALLET_PRIVATE_KEY_2_WITHOUT_0x>
# Never commit your populated .env.

# CLI chain configuration (defaults shown for Robinhood Chain).
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_IDENTIFIER=robinhood
CHAIN_ID=4663
CHAIN_NAME=Robinhood Chain

# Optional comma-separated eRPC upstream pools. When omitted, built-in public
# upstreams are used. The app-facing *_RPC_URL values are set to local eRPC by
# the start wrapper and are never passed back into eRPC as upstreams.
# ROBINHOOD_RPC_UPSTREAMS=https://rpc.mainnet.chain.robinhood.com,https://rpc.arrowrpc.com
# ETHEREUM_RPC_UPSTREAMS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org
ERPC_HOST=127.0.0.1
ERPC_PORT=4000
ERPC_METRICS_PORT=4001

OPENSEA_GRAPHQL_URL=https://gql.opensea.io/graphql
# Optional when the public endpoint needs an existing browser session.
# OPENSEA_COOKIES=

MINT_QUANTITY=1
MINT_TOKEN_ID=0
GAS_LIMIT_BUFFER_BPS=12000
# 0 means all eligible wallets concurrently.
WALLET_CONCURRENCY=0

HOST=127.0.0.1
PORT=18787
WAYPOINT_API_BASE=https://api.waypoint.tools
WAYPOINT_WS_URL=wss://api.waypoint.tools/ws/mints
