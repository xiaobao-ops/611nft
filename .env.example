# 611nft server. Keep loopback unless remote access is explicitly required.
WALLET_BOARD_PORT=8787
WALLET_BOARD_API_HOST=127.0.0.1
# Optional comma-separated listeners: 127.0.0.1,192.0.2.10
WALLET_BOARD_API_HOSTS=
# Required whenever any listener is not loopback. Generate at least 32 random bytes.
WALLET_BOARD_API_TOKEN=
WALLET_BOARD_TASK_CONFIRM_TTL_MS=600000
NFT_MINT_CONFIRM_TTL_MS=600000

# Optional RPC pools. Never commit authenticated RPC URLs.
ETH_RPC_URL=https://ethereum.publicnode.com
ETH_RPC_URLS=
BASE_RPC_URL=https://base.publicnode.com
BASE_RPC_URLS=
ARBITRUM_RPC_URL=https://arbitrum-one.publicnode.com
ARBITRUM_RPC_URLS=
OPTIMISM_RPC_URL=https://optimism.publicnode.com
OPTIMISM_RPC_URLS=
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_RPC_URLS=
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_RPC_URLS=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URLS=https://rpc.arrowrpc.com

# NFT monitor tuning.
MINT_MONITOR_API_BASE=
MINT_MONITOR_POLL_MS=5000
MINT_MONITOR_INITIAL_BLOCKS=120
MINT_MONITOR_MAX_BLOCKS_PER_SCAN=160
MINT_MONITOR_MINTER_BACKFILL_PAGE_DELAY_MS=3000
MINT_MONITOR_MINTER_BACKFILL_RETRY_MS=60000

# NFT mint execution safety.
NFT_MINT_GAS_BUFFER_BPS=12000
NFT_MINT_GRAPHQL_URL=
MINT_USER_AGENT=611nft/2.0
