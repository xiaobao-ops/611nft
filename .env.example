# Local NFT TOOL service. Keep loopback unless remote access is explicitly required.
WALLET_BOARD_PORT=8791
WALLET_BOARD_API_HOST=127.0.0.1
# Optional comma-separated listeners: 127.0.0.1,192.0.2.10
WALLET_BOARD_API_HOSTS=
# Required whenever any listener is not loopback. Generate at least 32 random bytes.
WALLET_BOARD_API_TOKEN=
WALLET_BOARD_TASK_CONFIRM_TTL_MS=600000
NFT_MINT_CONFIRM_TTL_MS=600000

# NFT TOOL module runtime and real chain data configuration.
# Optional RPC pools. Never commit authenticated RPC URLs.
ETH_RPC_URL=https://ethereum.publicnode.com
ETH_RPC_URLS=
BASE_RPC_URL=https://base.publicnode.com
BASE_RPC_URLS=
ARBITRUM_RPC_URL=https://arbitrum-one.publicnode.com
ARBITRUM_RPC_URLS=
OPTIMISM_RPC_URL=https://optimism.publicnode.com
OPTIMISM_RPC_URLS=
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_RPC_URLS=
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_RPC_URLS=
ZKS_RPC_URL=https://mainnet.era.zksync.io
ZKS_RPC_URLS=
SHIB_RPC_URL=https://www.shibrpc.com
SHIB_RPC_URLS=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URLS=https://rpc.arrowrpc.com

# Transaction broadcast profiles. Each profile has a built-in public multi-RPC
# pool, so the tool works without extra keys. Set one URL and/or a comma-separated
# URLS pool to replace that profile's built-in pool. These pools are independent
# from the public read lane above; the UI stores only the profile ID (and a
# short-lived custom ref).
NFT_WRITE_RPC_ETHEREUM_URL=
NFT_WRITE_RPC_ETHEREUM_URLS=
NFT_WRITE_RPC_BSC_URL=
NFT_WRITE_RPC_BSC_URLS=
NFT_WRITE_RPC_BASE_URL=
NFT_WRITE_RPC_BASE_URLS=
NFT_WRITE_RPC_ROBINHOOD_URL=
NFT_WRITE_RPC_ROBINHOOD_URLS=
# Custom RPC endpoints are entered in the transaction panel and kept in memory.

# Optional upstream WSS pools. Keep authenticated endpoints in .env only.
# A singular URL is tried before the comma-separated pool. Blank values use
# the built-in public pool where one exists; HTTP RPC remains the fallback.
WSS_RPC_URL_ETHEREUM=
WSS_RPC_URLS_ETHEREUM=
WSS_RPC_URL_BASE=
WSS_RPC_URLS_BASE=
WSS_RPC_URL_ARBITRUM=
WSS_RPC_URLS_ARBITRUM=
WSS_RPC_URL_OPTIMISM=
WSS_RPC_URLS_OPTIMISM=
WSS_RPC_URL_POLYGON=
WSS_RPC_URLS_POLYGON=
WSS_RPC_URL_BSC=
WSS_RPC_URLS_BSC=
WSS_RPC_URL_ZKS=
WSS_RPC_URLS_ZKS=
WSS_RPC_URL_SHIB=
WSS_RPC_URLS_SHIB=
WSS_RPC_URL_ROBINHOOD=
WSS_RPC_URLS_ROBINHOOD=

# NFT monitor tuning.
MINT_MONITOR_API_BASE=
MINT_MONITOR_POLL_MS=5000
MINT_MONITOR_INITIAL_BLOCKS=120
MINT_MONITOR_MAX_BLOCKS_PER_SCAN=160
MINT_MONITOR_REPLAY_BUFFER=500
MINT_MONITOR_BATCH_MS=2000
MINT_MONITOR_HEARTBEAT_MS=1000
NFT_MEDIA_CACHE_DIR=
MINT_MONITOR_MINTER_BACKFILL_PAGE_DELAY_MS=3000
MINT_MONITOR_MINTER_BACKFILL_RETRY_MS=60000

# Local intelligence and risk thresholds.
DEPLOYER_YOUNG_WALLET_DAYS=7
DEPLOYER_PROJECT_RISK_COUNT=5

# SeaDrop singleton addresses, comma-separated. A chain-specific value takes
# precedence over the global value. Blank uses the built-in canonical address.
SEADROP_ADDRESSES=
SEADROP_ADDRESSES_ETHEREUM=
SEADROP_ADDRESSES_BASE=
SEADROP_ADDRESSES_ARBITRUM=
SEADROP_ADDRESSES_OPTIMISM=
SEADROP_ADDRESSES_POLYGON=
SEADROP_ADDRESSES_BSC=
SEADROP_ADDRESSES_ROBINHOOD=
SEADROP_RADAR_POLL_MS=30000
SEADROP_SCAN_MAX_BLOCKS=5000
# 留空时按各链平均出块时间估算 7 天；可用 SEADROP_LOOKBACK_BLOCKS_<CHAIN_KEY> 覆盖单链
SEADROP_LOOKBACK_BLOCKS=
SEADROP_LOOKBACK_BLOCKS_ARBITRUM=

# Optional Telegram delivery. Secrets stay in .env and are never returned by APIs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NFT mint execution safety.
NFT_MINT_GAS_BUFFER_BPS=12000
NFT_MINT_GRAPHQL_URL=
MINT_USER_AGENT=NFT-TOOL/1.0

# NFT holdings indexer. Without one of these, holdings fall back to on-chain enumeration,
# which needs one RPC round trip per token and cannot read contracts that lack
# ERC721Enumerable at all (the Transfer-log fallback requires an archive RPC that public
# nodes refuse). Either key removes both limits and brings back name/image for free.
# ALCHEMY_API_KEY=
# OPENSEA_API_KEY=

# An archive-capable RPC is the no-API-key alternative for non-enumerable contracts.
# The public default (ethereum.publicnode.com) rejects every historical eth_getLogs.
# ETH_RPC_URL=

# Optional NFT listing router credentials and endpoint overrides.
# NOTE: api.reservoir.tools was shut down (docs.reservoir.tools now redirects to
# docs.relay.link). These settings only apply to a self-hosted Reservoir-compatible router.
# RESERVOIR_API_KEY=
# NFT_LISTING_ROUTER_URL=
# NFT_LISTING_ROUTER_URL_8453=

# Local wallet profiles. Copy real keys only into .env (which is gitignored),
# one 64-character hexadecimal private key per line, without a name or 0x.
# 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
