# ==========================================================================
# ASCII Cats 多钱包自动 Mint 配置
# 绝不提交本文件的真实值。MNEMONIC / 私钥 / 代理凭证都是敏感信息。
# ==========================================================================

# --- 钱包来源（二选一）---------------------------------------------------
# 多钱包模式：填 MNEMONIC，脚本按 DERIVATION_PATH_BASE/{0..WALLET_COUNT-1} 派生。
# 只要填了 MNEMONIC 即进入多钱包模式（优先于 PRIVATE_KEY）。
MNEMONIC=
# 多钱包私钥文件模式：不填 MNEMONIC，填 PRIVATE_KEYS_FILE，每行一个 0x 私钥。
PRIVATE_KEYS_FILE=
# 单钱包模式（兼容旧行为）：只填 PRIVATE_KEY、不填 MNEMONIC。
PRIVATE_KEY=

# --- 多钱包参数 ----------------------------------------------------------
WALLET_COUNT=50
DERIVATION_PATH_BASE=m/44'/60'/0'/0
# 代理池文件：支持 HTTP(S)、SOCKS5H，及自动识别的 IP:PORT:USER:PASS 四段式。
PROXY_FILE=proxies.txt
# 备用代理池文件：armed 时用于替换连不通或出口重复的代理；每条只用一次。
PROXY_RESERVE_FILE=
# Mint 开放后同时发射的钱包数上限。当前 50 钱包分享方案使用 20。
MINT_CONCURRENCY=20
# 旧静态代理预检兼容项；当前 20 静态 + 30 API 动态混合池仍要求静态数量精确匹配，不能用它绕过。
ALLOW_PROXY_REUSE=false

# --- 混合代理池 ----------------------------------------------------------
# proxies.txt 只保存静态代理；动态代理只在 mintOpen=true 后通过 API 获取并留在内存。
STATIC_PROXY_COUNT=20
DYNAMIC_PROXY_COUNT=30
# 仅填写供应商的 HTTPS JSON API URL；真实值只放本机 .env，不要提交或分享。
PROXY_API_URL=
PROXY_API_TIMEOUT_MS=10000
PROXY_CHECK_TIMEOUT_MS=10000
# 失败或重复出口最多替换的代理总数；超限会整批 fail closed。
PROXY_MAX_REPLACEMENTS=20
# 从首次 API 获取到代理池锁定的总时限。
PROXY_POOL_DEADLINE_MS=60000

# --- 发送闸门 ------------------------------------------------------------
# 默认演练（dry-run），不请求真票、不广播。真实发送需 ARM=true 或命令行 --arm。
ARM=false

# --- 链与安全上限（单/多钱包共用）---------------------------------------
RPC_URL=https://rpc.mainnet.chain.robinhood.com
TICKET_URL=https://asciicats.xyz/backend/api/mint-ticket.php
# 每次 Ticket HTTP 请求的硬超时；SIGINT 也会取消尚未完成的请求。
TICKET_TIMEOUT_MS=10000
# Mint 开放监控间隔；500ms 在发现速度与公共 RPC 负载之间取平衡。
POLL_INTERVAL_MS=500
MAX_GAS_LIMIT=500000
# EIP-1559 交易会将该值签入 maxFeePerGas 作为硬上限；实际支付仍由当时 base fee 决定。
MAX_FEE_PER_GAS_GWEI=5
CONFIRMATIONS=1
MINT_FAILED_RECEIPT_RETRIES=0
BLOCKSCOUT_API_KEY=
PROXY_PREHEAT=false
PROXY_PREHEAT_RECHECK_MS=0

# Optional Discord notifications through the local OpenClaw gateway.
# Resolve a channel ID with:
# openclaw directory groups list --channel discord --query crypto --json
OPENCLAW_DISCORD_TARGET=
OPENCLAW_TIMEOUT_MS=10000
