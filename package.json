{
  "name": "611nft",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "611nft local-first multi-chain NFT mint monitor and AWP wallet console",
  "license": "MIT",
  "author": "Zerorisklabs-V1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zerorisklabs-V1/611nft.git"
  },
  "bugs": {
    "url": "https://github.com/Zerorisklabs-V1/611nft/issues"
  },
  "homepage": "https://github.com/Zerorisklabs-V1/611nft#readme",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "nft",
    "mint",
    "multi-wallet",
    "ethereum",
    "robinhood-chain",
    "awp-wallet"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node --experimental-sqlite server/index.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "mint": "node server/nft-mint-cli.js",
    "test": "node --test test/*.test.js",
    "test:ascii": "npm --prefix ascii-cats-mint test",
    "check": "node --check server/*.js && npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "viem": "^2.43.2",
    "vite": "^7.3.0"
  },
  "devDependencies": {}
}
