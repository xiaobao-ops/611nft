{
  "name": "611nft",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "611nft local-first multi-chain NFT mint monitor and AWP wallet console",
  "license": "MIT",
  "author": "xiaobao-ops",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaobao-ops/611nft.git"
  },
  "bugs": {
    "url": "https://github.com/xiaobao-ops/611nft/issues"
  },
  "homepage": "https://github.com/xiaobao-ops/611nft#readme",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "nft",
    "mint",
    "multi-wallet",
    "ethereum",
    "robinhood-chain",
    "awp-wallet"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node --experimental-sqlite server/index.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "mint": "node server/nft-mint-cli.js",
    "test": "node --test test/*.test.js",
    "check:syntax": "find server -type f -name '*.js' -print0 | xargs -0 -n 1 node --check",
    "audit": "npm audit --audit-level=high --registry=https://registry.npmjs.org && npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "sbom": "mkdir -p output && cyclonedx-npm --output-file output/sbom.cdx.json --output-format JSON",
    "check": "npm run check:syntax && npm test && npm run build"
  },
  "dependencies": {
    "express": "^5.2.1",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  }
}
